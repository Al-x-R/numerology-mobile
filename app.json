{
  "expo": {
    "name": "Destiny Code",
    "slug": "destiny-code",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/NumericalCompass.png",
    "scheme": "numerologymobile",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.destinycode.app",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F21",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.destinycode.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/NumericalCompass.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/NumericalCompass.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0F21",
          "dark": {
            "backgroundColor": "#0D0F21"
          }
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2225591755579064~5326522792",
          "iosAppId": "ca-app-pub-2225591755579064~2213274293"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#D4AF37"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ffcb12d-2e63-4b0a-95dd-8162848dd57b"
      }
    },
    "owner": "destiny-code-team"
  }
}
