{
  "expo": {
    "name": "Destiny Code",
    "slug": "destiny-code",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/NumericalCompass.png",
    "scheme": "numerologymobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/images/NumericalCompass.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F21"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.destinycode.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "GIDClientID": "654109542106-4skcg0u5vknugji8qml6aq0ua46n23n4.apps.googleusercontent.com",
        "NSPhotoLibraryUsageDescription": "Allow access to photos to upload your profile avatar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F21",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.destinycode.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/NumericalCompass.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/NumericalCompass.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0F21",
          "dark": {
            "backgroundColor": "#0D0F21"
          }
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.654109542106-4skcg0u5vknugji8qml6aq0ua46n23n4",
          "iosClientId": "654109542106-4skcg0u5vknugji8qml6aq0ua46n23n4.apps.googleusercontent.com"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to let you set a profile picture."
        }
      ],
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "firebaseApiKey": "AIzaSyDoEovuUSQpoY3BAImvgBgMcBRI-UshhyQ",
      "firebaseAuthDomain": "destiny-code-cc093.firebaseapp.com",
      "firebaseProjectId": "destiny-code-cc093",
      "firebaseStorageBucket": "destiny-code-cc093.firebasestorage.app",
      "firebaseMessagingSenderId": "654109542106",
      "firebaseAppId": "1:654109542106:web:abcd1234efgh5678ijkl90",
      "googleWebClientId": "654109542106-lfljsbb7khnoqqm8mlip8jrancdp5e6m.apps.googleusercontent.com",
      "googleIosClientId": "654109542106-4skcg0u5vknugji8qml6aq0ua46n23n4.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "1ffcb12d-2e63-4b0a-95dd-8162848dd57b"
      }
    },
    "owner": "destiny-code-team"
