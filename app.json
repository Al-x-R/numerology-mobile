{
  "expo": {
    "name": "Destiny Code",
    "slug": "destiny-code",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/NumericalCompass.png",
    "scheme": "numerologymobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/images/NumericalCompass.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F21"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.destinycode.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F21",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.destinycode.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/NumericalCompass.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/NumericalCompass.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0F21",
          "dark": {
            "backgroundColor": "#0D0F21"
          }
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.654109542106-abcd1234efgh5678ijkl9012mnop3456"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3426a50d-f107-46d2-9e02-ed6f3c073957"
      },
      "firebaseApiKey": "${EXPO_PUBLIC_FIREBASE_API_KEY}",
      "firebaseAuthDomain": "${EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN}",
      "firebaseProjectId": "${EXPO_PUBLIC_FIREBASE_PROJECT_ID}",
      "firebaseStorageBucket": "${EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET}",
      "firebaseMessagingSenderId": "${EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID}",
      "firebaseAppId": "${EXPO_PUBLIC_FIREBASE_APP_ID}",
      "googleExpoClientId": "${EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID}",
      "googleIosClientId": "${EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID}",
      "googleAndroidClientId": "${EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID}",
      "router": {}
    },
    "owner": "al-x-r"
  }
}
