{
  "expo": {
    "name": "Destiny Code",
    "slug": "destiny-code",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/NumericalCompass.png",
    "scheme": "numerologymobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/NumericalCompass.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F21"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.yourapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F21",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/NumericalCompass.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/NumericalCompass.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0F21",
          "dark": {
            "backgroundColor": "#0D0F21"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
